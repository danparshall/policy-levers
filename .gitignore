# Data — CDS-shaped layout. raw/interim/processed are symlinks into
# ~/data/policy-levers/ (Syncthing-shared); reference/ stays real+tracked
# for small reference files. Entries are anchored so both real dirs and
# symlinks-into-store are covered; see check_repo_data.py in dotfiles.
/data/raw
/data/interim
/data/processed

# Legislative watcher runtime state + rendered digests (src/watcher — see docs/active/leg-watcher/)
data/watcher-state/**
digests/
data/watcher-cron.log

# Rendered essay PDFs (regenerate with scripts/render_q{1,4,8}.py)
essays/mats_chang/*/rendered/

# VS Code workspace (user-specific)
*.code-workspace

# Project instructions (local only)
_PROJECT_INSTRUCTIONS.md

# Git worktrees (nested per using-git-worktrees skill)
.worktrees/

# Notification state (tracks which digests have been emailed — see src/watcher/notify.py)
data/watcher-notified.json
